# Wheels position increment
var d_l_um = 0
var d_r_um = 0

# Wheels position tracking
var l_p_um = 0
var l_p_mm = 0
var r_p_um = 0
var r_p_mm = 0

# Wheels position error
var l_e_um = 0
var l_e_mm = 0
var r_e_um = 0
var r_e_mm = 0

# Speeds
var l_i = 0
var r_i = 0
var l_speed = 0
var r_speed = 0

# Wheel regulation done flags
var l_done = 0
var r_done = 0

# Flags
var i = 0
var done_flag = 0
var obstacle_flag = 0

sub left_pos_reg

	# Early return if done
	if l_done == 1 then
		return
	end

	# Update position estimate
	l_p_um += abs d_l_um
	l_p_mm += l_p_um / 1000
	l_p_um %= 1000

	# Compute position error
  	l_e_mm = {TARGET} - l_p_mm
	if l_p_um == 0 then
		l_e_um = 0
	else
		l_e_mm--
		l_e_um = 1000 - l_p_um
	end

	# Stop if within tolerance
	if l_e_mm < 0 or (l_e_mm == 0 and l_e_um <= 100) then
		motor.left.target = 0
		l_done = 1
		return
	end

	# Linear P controller
	if l_i < 40 then
		l_speed = (1 + l_i) * 10
		l_i++
	elseif l_e_mm >= 40 then
		l_speed = 400
	else
		l_speed = (1 + l_e_mm) * 10
	end

	# Differential P controller
	call math.muldiv(l_speed, l_speed, 20 + (r_p_mm - l_p_mm), 20)
  	
  	# Apply target speed
	motor.left.target = {LEFT_DIRECTION} l_speed

sub right_pos_reg

	# Early return if done
	if r_done == 1 then
		return
	end

	# Update position estimate
	r_p_um += abs d_r_um
	r_p_mm += r_p_um / 1000
	r_p_um %= 1000

	# Compute position error
  	r_e_mm = {TARGET} - r_p_mm
	if r_p_um == 0 then
		r_e_um = 0
	else
		r_e_mm--
		r_e_um = 1000 - r_p_um
	end

	# Stop if within tolerance
	if r_e_mm < 0 or (r_e_mm == 0 and r_e_um <= 100) then
		motor.right.target = 0
		r_done = 1
		return
	end

	# Linear P controller
	if r_i < 40 then
		r_speed = (1 + r_i) * 10
		r_i++
	elseif r_e_mm >= 40 then
		r_speed = 400
	else
		r_speed = (1 + r_e_mm) * 10
	end

	# Differential P controller
	call math.muldiv(r_speed, r_speed, 20 + (l_p_mm - r_p_mm), 20)
  	
  	# Apply target speed
	motor.right.target = {RIGHT_DIRECTION} r_speed

onevent motor

	# Compute wheel increment
    call math.muldiv(d_l_um, motor.left.speed,  {SCALE}, 10000)
    call math.muldiv(d_r_um, motor.right.speed, {SCALE}, 10000)

	# Early return if halt flag already set
	if done_flag == 1 then
		return
	end

	# Call position regulation for both wheels
	callsub left_pos_reg
	callsub right_pos_reg

	# Detect when both raise their 'done' flag
	if l_done == 1 and r_done == 1 then
		leds.top = [0, 32, 0]
		motor.left.target = 0
		motor.right.target = 0
		timer.period[0] = 2000
		done_flag = 1
		emit done
		return
	end

onevent prox

	for i in 1:4 do
		if prox.horizontal[i] > 2000 then
			leds.top = [32, 0, 0]
			motor.left.target = 0
			motor.right.target = 0
			timer.period[0] = 2000
			obstacle_flag = 1
			emit obstacle [(l_p_mm + r_p_mm) >> 1]
			return
		end
	end

onevent timer0

	# Resend event if missed by the application
	if done_flag == 1 then
		emit done
	elseif obstacle_flag == 1 then
		emit obstacle [(l_p_mm + r_p_mm) >> 1]
	end
