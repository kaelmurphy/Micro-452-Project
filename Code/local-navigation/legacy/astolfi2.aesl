# Odometry
var x_mm = {X_MM}
var y_mm = {Y_MM}
var theta = {THETA}
var d_l_um = 0
var d_r_um = 0
var d_s_um = 0
var d_theta = 0
var theta_mid = 0
var cos_mid = 0
var sin_mid = 0
var d_x_um = 0
var d_y_um = 0
var x_um = 0
var y_um = 0

# Controller
var e_x_mm = 0
var e_y_mm = 0
var e = 0
var epsilon = 0
var v = 0
var omega = 0
var mot_l = 0
var mot_r = 0

# Flags
var i = 0
var done_flag = 0
var obstacle_flag = 0

sub odometry

    # Compute linear and angular increments
    d_s_um = (d_l_um + d_r_um) >> 1
	call math.muldiv(d_theta, d_r_um - d_l_um, {TRACK}, 10000)

    # Compute x and y change
    theta_mid = theta + (d_theta >> 1)
    call math.cos(cos_mid, theta_mid)
    call math.sin(sin_mid, theta_mid)
    call math.muldiv(d_x_um, d_s_um, cos_mid, 32767)
    call math.muldiv(d_y_um, d_s_um, sin_mid, 32767)

    # Accumulate x, y and theta
    x_um += d_x_um
    x_mm += x_um / 1000
    x_um %= 1000
    y_um += d_y_um
    y_mm += y_um / 1000
    y_um %= 1000
    theta = theta + d_theta

sub controller

    # Compute carthesian error
	e_x_mm = {TARGET_X_MM} - x_mm
	e_y_mm = {TARGET_Y_MM} - y_mm

	# Compute polar error, clamp to avoid L2 norm overflow
    call math.clamp(e_x_mm, e_x_mm, -127, 127)
    call math.clamp(e_y_mm, e_y_mm, -127, 127)
    call math.sqrt(e, (e_x_mm * e_x_mm) + (e_y_mm * e_y_mm))
    call math.atan2(epsilon, e_y_mm, e_x_mm)
    epsilon -= theta

    # Halt if distance error is under threshold
    if e < 10 then
        motor.left.target = 0
        motor.right.target = 0
        timer.period[0] = 2000
        done_flag = 1
        emit done [x_mm, y_mm, theta]
        return
    end
    
    # Compute speeds
    call math.muldiv(omega, epsilon, 1, 3000)
    omega *= e
    call math.muldiv(v, e, 32767 - abs epsilon, 32767)
    call math.muldiv(v, v, 4, 1)

    # Apply command
    motor.left.target = v - omega
    motor.right.target = v + omega

onevent motor

    # Compute wheel increment
    call math.muldiv(d_l_um, motor.left.speed,  {SCALE}, 10000)
    call math.muldiv(d_r_um, motor.right.speed, {SCALE}, 10000)
    callsub odometry

    # Early return if a flag is already set
	if done_flag == 1 or obstacle_flag == 1 then
		return
    else
        callsub controller
	end

onevent prox

    # Check all front proximity sensors
	for i in 1:4 do

        # Above threshold, stop robot and notify application
		if prox.horizontal[i] > 4000 then
			motor.left.target = 0
            motor.right.target = 0
            timer.period[0] = 2000
            obstacle_flag = 1
            emit obstacle [x_mm, y_mm, theta]
            return
		end
	end

onevent timer0

	# Resend event if missed by the application
	if done_flag == 1 then
		emit done [x_mm, y_mm, theta]
	elseif obstacle_flag == 1 then
		emit obstacle [x_mm, y_mm, theta]
	end
