# Odometry
var x_mm = {X_MM}
var y_mm = {Y_MM}
var theta = {THETA}
var d_l_um = 0
var d_r_um = 0
var d_s_um = 0
var d_theta = 0
var theta_mid = 0
var cos_mid = 0
var sin_mid = 0
var d_x_um = 0
var d_y_um = 0
var x_um = 0
var y_um = 0

# Collision
var temp = 0
var x_r_1 = 0
var y_r_1 = 0
var x_r_2 = 0
var y_r_2 = 0

# Avoidance
var prox_sum = 0
var i = 0
var prox_delayed[50]
var state = 0

# Flags
var halt_flag = 0

sub odometry

    # Compute linear and angular increments
    d_s_um = (d_l_um + d_r_um) >> 1
	call math.muldiv(d_theta, d_r_um - d_l_um, {TRACK}, 10000)

    # Compute x and y change
    theta_mid = theta + (d_theta >> 1)
    call math.cos(cos_mid, theta_mid)
    call math.sin(sin_mid, theta_mid)
    call math.muldiv(d_x_um, d_s_um, cos_mid, 32767)
    call math.muldiv(d_y_um, d_s_um, sin_mid, 32767)

    # Accumulate x, y and theta
    x_um += d_x_um
    x_mm += x_um / 1000
    x_um %= 1000
    y_um += d_y_um
    y_mm += y_um / 1000
    y_um %= 1000
    theta = theta + d_theta

sub detect_path_collision

    # Rotate first vector in the reference frame of the first vertex tolerances
    call math.muldiv(temp, x_mm, {C_1}, 32767)
    x_r_1 += temp
    call math.muldiv(temp, y_mm, -{S_1}, 32767)
    x_r_1 += temp
    call math.muldiv(temp, x_mm, {S_1}, 32767)
    y_r_1 += temp
    call math.muldiv(temp, y_mm, {C_1}, 32767)
    y_r_1 += temp

    # Check if vector collide with first vertex tolerances
    if x_r_1 > {X_MIN_1} and x_r_1 < {X_MAX_1} and y_r_1 > {Y_MIN_1} and y_r_1 < {Y_MAX_1} then
        callsub halt
        return
    end

    # Rotate second vector in the reference frame of the second vertex tolerances
    call math.muldiv(temp, x_mm, {C_2}, 32767)
    x_r_2 += temp
    call math.muldiv(temp, y_mm, -{S_2}, 32767)
    x_r_2 += temp
    call math.muldiv(temp, x_mm, {S_2}, 32767)
    y_r_2 += temp
    call math.muldiv(temp, y_mm, {C_2}, 32767)
    y_r_2 += temp

    # Check if vector collide with first vertex tolerances
    if x_r_2 > {X_MIN_2} and x_r_2 < {X_MAX_2} and y_r_2 > {Y_MIN_2} and y_r_2 < {Y_MAX_2} then
        callsub halt
        return
    end

sub halt
    motor.left.target = 0
    motor.right.target = 0
	timer.period[0] = 2000
	halt_flag = 1
	emit done

onevent motor

    # Compute wheel increment
    call math.muldiv(d_l_um, motor.left.speed,  {SCALE}, 10000)
    call math.muldiv(d_r_um, motor.right.speed, {SCALE}, 10000)
    callsub odometry

    # Early return if halt flag already set
	if halt_flag == 1 then
		return
	end

    callsub detect_path_collision

onevent prox

    # Early return if halt flag already set
	if halt_flag == 1 then
		return
	end

    # Compute sum of proximity sensors
    prox_sum = 0
    for i in 0:4 do
        prox_sum += prox.horizontal[i]
    end

    # Avoid from the left
    if state == 0 then

        # Turn left until obstacle is not in sight
        if prox_sum > 0 then
            motor.left.target = -100
            motor.right.target = 100

        # Initialize prox delay buffer, then next state
        else
            call math.fill(prox_delayed, 0)
            state = 2
        end

    # Avoid from the right
    elseif state == 1 then

        # Turn right until obstacle is not in sight
        if prox_sum > 0 then
            motor.right.target = -100
            motor.left.target = 100

        # Initialize prox delay buffer, then next state
        else
            call math.fill(prox_delayed, 0)
            state = 3
        end

    # Follow right side of obstacle
    elseif state == 2 then

        # When obstacle detected, actualize whole buffer
        if prox.horizontal[4] > 0 then
            call math.fill(prox_delayed, prox.horizontal[4])

        # Otherwise, delay samples
        else
            for i in 48:0 step -1 do
                prox_delayed[i + 1] = prox_delayed[i]
            end
            prox_delayed[0] = prox.horizontal[4]
        end

        # Turn toward obstacle if out of sight for more that 5 s
        motor.left.target = 100
        if prox_delayed[49] == 0 then
            motor.right.target = -100
        else
            motor.right.target = 100
        end

    # Follow left side of obstacle
    elseif state == 3 then

        # When obstacle detected, actualize whole buffer
        if prox.horizontal[0] > 0 then
            call math.fill(prox_delayed, prox.horizontal[0])

        # Otherwise, delay samples
        else
            for i in 48:0 step -1 do
                prox_delayed[i + 1] = prox_delayed[i]
            end
            prox_delayed[0] = prox.horizontal[0]
        end

        # Turn toward obstacle if out of sight for more that 5 s
        motor.right.target = 100
        if prox_delayed[49] == 0 then
            motor.left.target = -100
        else
            motor.left.target = 100
        end
    end

onevent timer0

	# Resend event if missed by the application
	if halt_flag == 1 then
		emit done
	end
